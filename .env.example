# Default: Google Gemini. Get your key at https://aistudio.google.com/apikey
# Only GEMINI_API_KEY is required for the default LLM configuration.
GEMINI_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.8-flash
# Other OpenAI-compatible providers: change URL/model and set LLM_API_KEY.
LLM_API_KEY=
LLM_TIMEOUT=240
# Set false if your server does not support response_format=json_object.
LLM_JSON_MODE=true

# VieNeu SDK 3.8.3: v3turbo (quality) or v3nano (lighter, lower quality).
VIENEU_MODE=v3turbo
# onnx = CPU; auto = allow the SDK to choose GPU when CUDA dependencies exist.
VIENEU_BACKEND=onnx
VIENEU_VOICE=Hải Đăng
# fp32 is the safe CPU default. int8 requires compatible CPU instructions.
VIENEU_PRECISION=fp32
# Optional reference clip, used instead of the preset voice.
VIENEU_REF_AUDIO=

# Optional font that supports Vietnamese. Bundled DejaVu Sans is the default.
VIDEO_FONT=
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
